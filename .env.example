# Copie para o arquivo de ambiente local (gitignored) e preencha. Este arquivo é VERSIONADO: só nomes.
# ENV-04/05: a aplicação e o compose FALHAM ao iniciar, citando o nome, se uma OBRIGATÓRIA faltar.

# --- Obrigatórias ---
# Senha do Postgres do compose. Gere uma aleatória em hexadecimal (sem caracteres especiais,
# porque entra numa URL): node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
POSTGRES_PASSWORD=

# --- Opcionais (default seguro) ---
# Porta publicada em 127.0.0.1 (default 3000)
API_PORT=
# fatal | error | warn | info | debug | trace | silent (default info)
LOG_LEVEL=

# --- Só fora do compose (rodando a api direto com `npm run dev -w @ailow/api`) ---
# DATABASE_URL=
# --- Só no CI / testes locais com Postgres externo (descartável!) ---
# DATABASE_URL_TEST=
