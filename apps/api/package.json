{
  "name": "@ailow/api",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "migrate": "node-pg-migrate -m migrations --migrations-table pgmigrations",
    "admin:criar": "tsx src/admin/criar-admin-cli.ts"
  },
  "dependencies": {
    "@ailow/shared": "*",
    "@fastify/cookie": "11.1.5",
    "@fastify/swagger": "9.9.3",
    "argon2": "0.45.2",
    "fastify": "5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "node-pg-migrate": "9.0.0",
    "otpauth": "9.6.0",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "8.23.1",
    "embedded-postgres": "18.6.0-beta.19",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
